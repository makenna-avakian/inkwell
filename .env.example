# Neon Postgres connection string (see aidlc-docs/construction/shared-infrastructure.md)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Cron job protection (aidlc-docs/construction/unit-1-auth/infrastructure-design/infrastructure-design.md)
CRON_SECRET="generate-a-long-random-string"

# Sentry (aidlc-docs/construction/shared-infrastructure.md)
SENTRY_DSN=""

# Cloudflare R2 (aidlc-docs/construction/unit-2-shops/infrastructure-design/infrastructure-design.md)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="inkwell-media"
R2_PUBLIC_URL="https://media.inkwell.app"
# dev | staging | prod — used as the R2 object key prefix
R2_ENVIRONMENT_PREFIX="dev"
